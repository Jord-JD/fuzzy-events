{
  "name": "jord-jd/fuzzy-events",
  "description": "Perform actions based on fuzzy string matches",
  "type": "library",
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "require": {
    "php": ">=7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^7.5 || ^8.5 || ^9.6"
  },
  "autoload": {
    "psr-4": {
      "JordJD\\FuzzyEvents\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JordJD\\FuzzyEvents\\TestClasses\\": "tests/Unit/includes/TestClasses/",
      "JordJD\\FuzzyEvents\\Unit\\": "tests/Unit/"
    }
  },
  "replace": {
    "divineomega/fuzzy-events": "self.version"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "4.0-dev"
    }
  }
}
